---
interface Member {
  name: string;
  avatarEmoji: string;
}

interface Props {
  from: Member;
  to: Member;
  delta: number;
  reason?: string | null;
  createdAt: Date | number;
  variant?: 'compact' | 'full';
}

const { from, to, delta, reason, createdAt, variant = 'full' } = Astro.props;
const positive = delta > 0;
const date = new Date(createdAt);
---

{variant === 'full' ? (
  <li class="card p-5 flex items-center gap-5 animate-slide-up">
    <!-- Delta badge -->
    <div
      class={`w-16 h-16 border-4 border-[var(--border)] flex items-center justify-center text-2xl font-black flex-shrink-0 shadow-[3px_3px_0px_var(--border)] ${
        positive
          ? 'bg-[var(--positive-bg)] text-[var(--positive)]'
          : 'bg-[var(--negative-bg)] text-[var(--negative)]'
      }`}
    >
      {positive ? '+' : ''}{delta}
    </div>
    <!-- Info -->
    <div class="flex-1 min-w-0">
      <div class="text-base font-bold leading-tight">
        <span class="font-black uppercase tracking-tight text-lg">{from.name}</span>
        <span class="italic text-[var(--muted)]"> {positive ? 'gave' : 'took'} </span>
        <span class={`font-black ${positive ? 'text-[var(--positive)]' : 'text-[var(--negative)]'}`}>
          {Math.abs(delta)} pt{Math.abs(delta) !== 1 ? 's' : ''}
        </span>
        <span class="italic text-[var(--muted)]"> {positive ? 'to' : 'from'} </span>
        <span class="font-black uppercase tracking-tight text-lg">{to.name}</span>
      </div>
      {reason && (
        <div class="mt-2 text-sm text-[var(--muted)] italic font-bold">"{reason}"</div>
      )}
      <div class="mt-1 text-xs font-black uppercase text-[var(--muted)]">
        {date.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' })}
        {' · '}{date.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' })}
      </div>
    </div>
    <!-- Avatars -->
    <div class="flex flex-col items-center gap-1 flex-shrink-0">
       <div class="w-10 h-10 border-2 border-[var(--border)] bg-white flex items-center justify-center text-xl shadow-[2px_2px_0px_var(--border)]" title={from.name}>
        {from.avatarEmoji}
      </div>
      <span class="text-sm font-black">{positive ? '↓' : '↑'}</span>
       <div class="w-10 h-10 border-2 border-[var(--border)] bg-white flex items-center justify-center text-xl shadow-[2px_2px_0px_var(--border)]" title={to.name}>
        {to.avatarEmoji}
      </div>
    </div>
  </li>
) : (
  <li class="card card-sm px-5 py-4 flex items-center gap-4 text-base font-bold animate-slide-up">
    <span
      class={`text-2xl font-black px-2 border-2 border-[var(--border)] shadow-[2px_2px_0px_var(--border)] ${positive ? "bg-[var(--positive-bg)] text-[var(--positive)]" : "bg-[var(--negative-bg)] text-[var(--negative)]"}`}
    >
      {positive ? "+" : ""}
      {delta}
    </span>
    <div class="flex-1 min-w-0">
      <span class="font-black uppercase">{from.name}</span>
      <span class="italic text-[var(--muted)]">
        {" "}
        {positive ? "gave" : "took"} to{" "}
      </span>
      <span class="font-black uppercase">{to.name}</span>
      {reason && (
        <span class="block text-sm text-[var(--muted)] italic mt-0.5">
          "{reason}"
        </span>
      )}
    </div>
    <span class="text-xs font-black uppercase text-[var(--muted)] flex-shrink-0">
      {date.toLocaleDateString()}
    </span>
  </li>
)}
