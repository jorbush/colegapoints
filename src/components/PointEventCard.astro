---
interface Member {
  name: string;
  avatarEmoji: string;
}

interface Props {
  from: Member;
  to: Member;
  delta: number;
  reason?: string | null;
  createdAt: Date | number;
  variant?: 'compact' | 'full';
}

const { from, to, delta, reason, createdAt, variant = 'full' } = Astro.props;
const positive = delta > 0;
const date = new Date(createdAt);
---

{
  variant === 'full' ? (
    <li class="card animate-slide-up flex items-center gap-5 p-5">
      {/* Delta badge */}
      <div
        class={`flex h-16 w-16 flex-shrink-0 items-center justify-center border-4 border-[var(--border)] text-2xl font-black shadow-[3px_3px_0px_var(--border)] ${
          positive
            ? 'bg-[var(--positive-bg)] text-[var(--positive)]'
            : 'bg-[var(--negative-bg)] text-[var(--negative)]'
        }`}
      >
        {positive ? '+' : ''}
        {delta}
      </div>
      {/* Info */}
      <div class="min-w-0 flex-1">
        <div class="text-base leading-tight font-bold">
          <span class="text-lg font-black tracking-tight uppercase">{from.name}</span>
          <span class="text-[var(--muted)] italic"> {positive ? 'gave' : 'took'} </span>
          <span
            class={`font-black ${positive ? 'text-[var(--positive)]' : 'text-[var(--negative)]'}`}
          >
            {Math.abs(delta)} pt{Math.abs(delta) !== 1 ? 's' : ''}
          </span>
          <span class="text-[var(--muted)] italic"> {positive ? 'to' : 'from'} </span>
          <span class="text-lg font-black tracking-tight uppercase">{to.name}</span>
        </div>
        {reason && <div class="mt-2 text-sm font-bold text-[var(--muted)] italic">"{reason}"</div>}
        <div class="mt-1 text-xs font-black text-[var(--muted)] uppercase">
          {date.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' })}
          {' · '}
          {date.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' })}
        </div>
      </div>
      {/* Avatars */}
      <div class="flex flex-shrink-0 flex-col items-center gap-1">
        <div
          class="flex h-10 w-10 items-center justify-center border-2 border-[var(--border)] bg-white text-xl shadow-[2px_2px_0px_var(--border)]"
          title={from.name}
        >
          {from.avatarEmoji}
        </div>
        <span class="text-sm font-black">{positive ? '↓' : '↑'}</span>
        <div
          class="flex h-10 w-10 items-center justify-center border-2 border-[var(--border)] bg-white text-xl shadow-[2px_2px_0px_var(--border)]"
          title={to.name}
        >
          {to.avatarEmoji}
        </div>
      </div>
    </li>
  ) : (
    <li class="card card-sm animate-slide-up flex items-center gap-4 px-5 py-4 text-base font-bold">
      <span
        class={`border-2 border-[var(--border)] px-2 text-2xl font-black shadow-[2px_2px_0px_var(--border)] ${positive ? 'bg-[var(--positive-bg)] text-[var(--positive)]' : 'bg-[var(--negative-bg)] text-[var(--negative)]'}`}
      >
        {positive ? '+' : ''}
        {delta}
      </span>
      <div class="min-w-0 flex-1">
        <span class="font-black uppercase">{from.name}</span>
        <span class="text-[var(--muted)] italic"> {positive ? 'gave' : 'took'} to </span>
        <span class="font-black uppercase">{to.name}</span>
        {reason && <span class="mt-0.5 block text-sm text-[var(--muted)] italic">"{reason}"</span>}
      </div>
      <span class="flex-shrink-0 text-xs font-black text-[var(--muted)] uppercase">
        {date.toLocaleDateString()}
      </span>
    </li>
  )
}
