---
interface Props {
  groupId: string;
  members: { id: string; name: string; avatarEmoji: string }[];
}

const { groupId, members } = Astro.props;
---

<div
  id="points-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-[rgba(0,0,0,0.8)] p-4"
  data-group-id={groupId}
  data-members={JSON.stringify(members)}
>
  <div class="card animate-pop-in relative w-full max-w-sm p-8" id="points-modal-inner">
    <div class="mb-8 flex items-center justify-between">
      <h3 class="text-3xl font-black uppercase italic">Points</h3>
      <button id="close-modal-btn" class="btn btn-ghost h-10 w-10 text-2xl font-black">✕</button>
    </div>

    <div class="flex flex-col gap-6">
      <div>
        <label class="mb-3 block text-sm font-black uppercase">Who gets the points?</label>
        <div id="target-member-list" class="flex flex-wrap gap-2">
          <!-- populated by JS -->
        </div>
      </div>

      <div>
        <label class="mb-3 block text-sm font-black uppercase">Amount</label>
        <div class="grid grid-cols-3 gap-2">
          {
            [-5, -3, -1, 1, 3, 5].map((v) => (
              <button
                type="button"
                data-delta={v}
                class={`delta-btn btn py-3 text-xl font-black ${v > 0 ? 'bg-[var(--positive-bg)] text-[var(--positive)]' : 'bg-[var(--negative-bg)] text-[var(--negative)]'}`}
              >
                {v > 0 ? '+' : ''}
                {v}
              </button>
            ))
          }
        </div>
        <input id="custom-delta" type="number" placeholder="Or custom amount…" class="input mt-3" />
      </div>

      <div>
        <label class="mb-1 block text-sm font-black uppercase">Reason (optional)</label>
        <input
          id="point-reason"
          type="text"
          placeholder="Why tho? e.g. Forgot to pay back"
          maxlength="100"
          class="input"
        />
      </div>

      <button
        id="submit-points-btn"
        class="btn btn-primary mt-2 w-full py-4 text-xl uppercase italic"
      >
        Send Points ⭐
      </button>
      <p
        id="points-error"
        class="hidden border-2 border-[var(--negative)] bg-[var(--negative-bg)] p-2 text-sm font-bold text-[var(--negative)]"
      >
      </p>
    </div>
  </div>
</div>

<script>
  import { initPointsModal } from '../lib/points-modal';

  const modal = document.getElementById('points-modal') as HTMLElement;
  if (modal) {
    initPointsModal(modal);
  }
</script>
