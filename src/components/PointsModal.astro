---
import { getLocale, useTranslation } from '../lib/i18n';

const locale = getLocale(Astro.cookies, Astro.request.headers);
const t = useTranslation(locale);

interface Props {
  groupId: string;
  members: { id: string; name: string; avatarEmoji: string }[];
}

const { groupId, members } = Astro.props;
---

<div
  id="points-modal"
  class="fixed inset-0 z-50 overflow-y-auto bg-[rgba(0,0,0,0.8)] p-0 sm:flex sm:flex-col sm:items-center sm:justify-center sm:p-4"
  data-group-id={groupId}
  data-members={JSON.stringify(members)}
>
  <div
    class="card animate-pop-in relative flex min-h-dvh w-full flex-col justify-start rounded-none border-0 border-solid border-[var(--border)] bg-[var(--surface)] px-6 pt-[calc(1.5rem+env(safe-area-inset-top))] pb-[calc(1.5rem+env(safe-area-inset-bottom))] shadow-none sm:h-auto sm:min-h-0 sm:max-w-sm sm:justify-start sm:rounded-lg sm:border-4 sm:p-8 sm:shadow-[var(--shadow)]"
    id="points-modal-inner"
  >
    <div class="mb-8 flex items-center justify-between">
      <h3 class="text-2xl font-black uppercase italic sm:text-3xl">{t('modal.points_title')}</h3>
      <button id="close-modal-btn" class="btn btn-ghost h-10 w-10 text-2xl font-black">✕</button>
    </div>

    <div class="flex flex-col gap-6">
      <div>
        <label class="mb-3 block text-sm font-black uppercase">{t('modal.who_gets')}</label>
        <div id="target-member-list" class="flex flex-wrap gap-2">
          <!-- populated by JS -->
        </div>
      </div>

      <div>
        <label class="mb-3 block text-sm font-black uppercase">{t('modal.amount')}</label>
        <div class="grid grid-cols-3 gap-2">
          {
            [-5, -3, -1, 1, 3, 5].map((v) => (
              <button
                type="button"
                data-delta={v}
                class={`delta-btn btn py-3 text-xl font-black ${v > 0 ? 'bg-[var(--positive-bg)] text-[var(--positive)]' : 'bg-[var(--negative-bg)] text-[var(--negative)]'}`}
              >
                {v > 0 ? '+' : ''}
                {v}
              </button>
            ))
          }
        </div>
        <input
          id="custom-delta"
          type="number"
          placeholder={t('modal.custom_amount_placeholder')}
          class="input mt-3"
        />
      </div>

      <div>
        <label class="mb-1 block text-sm font-black uppercase">{t('modal.reason')}</label>
        <input
          id="point-reason"
          type="text"
          placeholder={t('modal.reason_placeholder')}
          maxlength="100"
          class="input"
        />
      </div>
    </div>

    <!-- Submit Footer Container pushed to bottom on mobile -->
    <div class="mt-auto flex w-full flex-col gap-2 pt-6 sm:mt-4 sm:pt-0">
      <button id="submit-points-btn" class="btn btn-primary w-full py-4 text-xl uppercase italic">
        {t('modal.submit')}
      </button>
      <p
        id="points-error"
        class="hidden border-2 border-[var(--negative)] bg-[var(--negative-bg)] p-2 text-sm font-bold text-[var(--negative)]"
      >
      </p>
    </div>
  </div>
</div>

<script>
  import { initPointsModal } from '../lib/points-modal';

  const modal = document.getElementById('points-modal') as HTMLElement;
  if (modal) {
    initPointsModal(modal);
  }
</script>
