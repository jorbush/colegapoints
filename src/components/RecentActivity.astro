---
import PointEventCard from './PointEventCard.astro';
import { getLocale, useTranslation } from '../lib/i18n';

const locale = getLocale(Astro.cookies, Astro.request.headers);
const t = useTranslation(locale);

interface Event {
  fromMemberId: string;
  toMemberId: string;
  delta: number;
  reason?: string | null;
  createdAt: number | Date;
}

interface Member {
  id: string;
  name: string;
  avatarEmoji: string;
}

interface Props {
  events: Event[];
  memberMap: Record<string, Member>;
  groupId: string;
  totalEventsCount: number;
}

const { events, memberMap, groupId, totalEventsCount } = Astro.props;
---

{
  events.length > 0 && (
    <section class="animate-fade-in">
      <h2 class="mb-6 inline-block border-2 border-[var(--border)] bg-[var(--accent)] px-2 text-sm font-black tracking-widest uppercase">
        {t('activity.title')}
      </h2>
      <ul class="flex flex-col gap-3">
        {events.map((ev) => {
          const from = memberMap[ev.fromMemberId];
          const to = memberMap[ev.toMemberId];
          if (!from || !to) return null;
          return (
            <PointEventCard
              from={from}
              to={to}
              delta={ev.delta}
              reason={ev.reason}
              createdAt={ev.createdAt}
              variant="compact"
            />
          );
        })}
      </ul>
      {totalEventsCount > 5 && (
        <a
          href={`/group/${groupId}/history`}
          class="btn btn-outline mt-4 w-full py-3 text-sm uppercase italic"
        >
          {t('activity.full_history')}
        </a>
      )}
    </section>
  )
}
