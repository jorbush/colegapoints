---
interface Member {
  id: string;
  name: string;
  avatarEmoji: string;
  joinedAt: number | Date;
}

interface Props {
  members: Member[];
  pointTotals: Record<string, number>;
}

const { members, pointTotals } = Astro.props;

// Sort members by points descending for leaderboard
const sorted = [...members].sort((a, b) => (pointTotals[b.id] ?? 0) - (pointTotals[a.id] ?? 0));
---

<section class="mb-12">
  <h2
    class="mb-6 inline-block border-2 border-[var(--border)] bg-[var(--accent)] px-2 text-sm font-black tracking-widest uppercase"
  >
    Leaderboard
  </h2>
  {
    sorted.length === 0 ? (
      <div class="card p-12 text-center">
        <div class="mb-4 text-6xl">🏜️</div>
        <p class="text-2xl font-black uppercase italic">No colegas yet.</p>
        <p class="mt-2 text-lg font-bold">Share the link to get the party started!</p>
      </div>
    ) : (
      <ul class="stagger flex flex-col gap-4">
        {sorted.map((m, i) => {
          const pts = pointTotals[m.id] ?? 0;
          const isTop = i === 0 && pts > 0;
          const medalEmojis = ['🥇', '🥈', '🥉'];
          const medal = medalEmojis[i] ?? null;
          return (
            <li
              id={`member-${m.id}`}
              class={`card animate-slide-up flex items-center gap-5 p-5 ${isTop ? 'bg-[var(--accent-light)]' : ''}`}
              data-member-id={m.id}
            >
              <div class="flex h-16 w-16 flex-shrink-0 items-center justify-center border-4 border-[var(--border)] bg-white text-4xl shadow-[3px_3px_0px_var(--border)]">
                {m.avatarEmoji}
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                  <span class="truncate text-2xl font-black tracking-tight uppercase">
                    {m.name}
                  </span>
                  {medal && <span class="text-xl">{medal}</span>}
                  {isTop && <span class="tag tag-brand ml-2">Top Colega</span>}
                </div>
                <div class="mt-1 text-sm font-bold italic">
                  Joined {new Date(m.joinedAt).toLocaleDateString()}
                </div>
              </div>
              <div
                class={`border-4 border-[var(--border)] px-4 py-2 text-4xl font-black tabular-nums shadow-[3px_3px_0px_var(--border)] ${pts > 0 ? 'bg-[var(--positive-bg)] text-[var(--positive)]' : pts < 0 ? 'bg-[var(--negative-bg)] text-[var(--negative)]' : 'bg-white text-[var(--muted)]'}`}
              >
                {pts > 0 ? '+' : ''}
                {pts}
              </div>
            </li>
          );
        })}
      </ul>
    )
  }
</section>
