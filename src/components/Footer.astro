---
import pkg from '../../package.json';
import LanguagePicker from './LanguagePicker.astro';
import { getLocale, useTranslation } from '../lib/i18n';

const locale = getLocale(Astro.cookies, Astro.request.headers);
const t = useTranslation(locale);

const version = pkg.version;
const versionUrl = `https://github.com/jorbush/colegapoints/releases/tag/v${version}`;
const githubProfileUrl = 'https://github.com/jorbush';
---

<footer
  class="mt-auto w-full border-[var(--border)] border-t-[var(--bw)] bg-[var(--surface)] px-4 py-6"
>
  <div
    class="mx-auto flex max-w-lg flex-col items-center justify-between gap-4 text-center sm:flex-row sm:text-left"
  >
    <div class="text-sm font-bold text-[var(--text)]">
      {t('footer.created_by')}{' '}
      <a
        href={githubProfileUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-black underline decoration-[var(--accent)] decoration-2 underline-offset-2 transition-colors hover:text-[var(--brand)]"
      >
        jorbush
      </a>
    </div>

    <div class="flex items-center gap-4">
      <LanguagePicker />
      <a
        href={versionUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="tag tag-accent inline-flex items-center gap-1.5 transition-transform hover:translate-x-0.5 hover:-translate-y-0.5"
      >
        <span>v{version}</span>
      </a>
    </div>
  </div>
</footer>
