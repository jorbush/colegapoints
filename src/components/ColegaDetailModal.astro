---
import { AVAILABLE_EMOJIS } from '../lib/constants';
import { getLocale, useTranslation } from '../lib/i18n';

const locale = getLocale(Astro.cookies, Astro.request.headers);
const t = useTranslation(locale);

interface Props {
  members: { id: string; name: string; avatarEmoji: string; joinedAt: number | Date | string }[];
  events: {
    id: string;
    groupId: string;
    fromMemberId: string;
    toMemberId: string;
    delta: number;
    reason: string | null;
    createdAt: number | Date | string;
  }[];
}

const { members, events } = Astro.props;
---

<div
  id="colega-detail-modal"
  class="animate-fade-in fixed inset-0 z-50 overflow-y-auto bg-[rgba(0,0,0,0.8)] p-0 sm:flex sm:flex-col sm:items-center sm:justify-center sm:p-4"
  data-members={JSON.stringify(members)}
  data-events={JSON.stringify(events)}
>
  <div
    class="card animate-pop-in relative flex min-h-dvh w-full flex-col justify-start rounded-none border-0 border-solid border-[var(--border)] bg-[var(--surface)] px-6 pt-[calc(1.5rem+env(safe-area-inset-top))] pb-[calc(1.5rem+env(safe-area-inset-bottom))] shadow-none sm:h-auto sm:min-h-0 sm:max-w-md sm:justify-start sm:rounded-lg sm:border-4 sm:p-8 sm:shadow-[var(--shadow)]"
    id="colega-detail-modal-inner"
  >
    <div class="mb-6 flex items-center justify-between">
      <h3 class="text-2xl font-black tracking-tight uppercase italic sm:text-3xl">
        {t('profile.title')}
      </h3>
      <button id="close-detail-modal-btn" class="btn btn-ghost h-10 w-10 text-2xl font-black"
        >✕</button
      >
    </div>

    <!-- Modal Content -->
    <div class="flex flex-col gap-6">
      <!-- Member Info Header -->
      <div
        id="detail-info-header"
        class="flex items-center gap-4 border-b-4 border-[var(--border)] pb-5"
      >
        <div
          id="detail-avatar"
          class="flex h-16 w-16 animate-bounce items-center justify-center border-4 border-[var(--border)] bg-white text-4xl shadow-[3px_3px_0px_var(--border)] select-none"
          style="animation-duration: 3s"
        >
          😊
        </div>
        <div class="min-w-0 flex-1">
          <div class="flex items-center justify-between gap-2">
            <h4 id="detail-name" class="truncate text-2xl font-black tracking-tight uppercase">
              Name
            </h4>
            <button
              id="edit-profile-btn"
              class="btn btn-ghost h-8 border-2 border-[var(--border)] px-2 py-0.5 text-xs font-black tracking-wider uppercase shadow-[1px_1px_0px_var(--border)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
              style="display: none;"
              type="button">{t('profile.edit')}</button
            >
          </div>
          <p id="detail-joined" class="text-xs font-bold text-[var(--muted)] italic">Joined Date</p>
        </div>
      </div>

      <!-- Edit Profile Form (hidden by default) -->
      <div
        id="edit-profile-form"
        class="hidden flex-col gap-4 border-b-4 border-[var(--border)] pb-5"
      >
        <div>
          <label class="mb-1 block text-xs font-black tracking-wider text-[var(--muted)] uppercase"
            >{t('profile.name_label')}</label
          >
          <input
            id="edit-name"
            type="text"
            placeholder={t('profile.name_placeholder')}
            maxlength="30"
            class="input"
          />
        </div>
        <div>
          <label class="mb-2 block text-xs font-black tracking-wider text-[var(--muted)] uppercase"
            >{t('profile.emoji_label')}</label
          >
          <div id="edit-emoji-picker" class="flex flex-wrap gap-2">
            {
              AVAILABLE_EMOJIS.map((e) => (
                <button
                  type="button"
                  data-emoji={e}
                  class="edit-emoji-btn border-2 border-[var(--border)] bg-white p-2 text-2xl shadow-[2px_2px_0px_var(--border)] transition-transform hover:translate-x-0.5 hover:-translate-y-0.5 active:translate-x-0 active:translate-y-0 active:shadow-none"
                >
                  {e}
                </button>
              ))
            }
          </div>
        </div>
        <div class="flex gap-3">
          <button id="save-profile-btn" class="btn btn-primary flex-1 py-2 text-sm uppercase italic"
            >{t('profile.save')}</button
          >
          <button id="cancel-profile-btn" class="btn btn-ghost flex-1 py-2 text-sm uppercase"
            >{t('profile.cancel')}</button
          >
        </div>
        <p
          id="edit-error"
          class="hidden border-2 border-[var(--negative)] bg-[var(--negative-bg)] p-2 text-center text-sm font-bold text-[var(--negative)]"
        >
        </p>
      </div>

      <!-- Point Display & Rank -->
      <div class="grid grid-cols-2 gap-3 sm:gap-4">
        <div
          class="card border-4 border-[var(--border)] bg-white p-4 text-center shadow-[3px_3px_0px_var(--border)]"
        >
          <p class="text-xs font-black tracking-wider text-[var(--muted)] uppercase">
            {t('profile.exact_points')}
          </p>
          <p
            id="detail-points"
            class="mt-2 text-3xl font-black text-[var(--positive)] tabular-nums"
          >
            +0
          </p>
        </div>
        <div
          class="card border-4 border-[var(--border)] bg-white p-4 text-center shadow-[3px_3px_0px_var(--border)]"
        >
          <p class="text-xs font-black tracking-wider text-[var(--muted)] uppercase">
            {t('profile.squad_rank')}
          </p>
          <p id="detail-rank" class="mt-2 text-3xl font-black">#1</p>
        </div>
      </div>

      <!-- Statistics Section -->
      <div>
        <label class="mb-2 block text-xs font-black tracking-wider text-[var(--muted)] uppercase"
          >{t('profile.statistics')}</label
        >
        <div
          class="flex flex-col gap-2 rounded-lg border-4 border-[var(--border)] bg-[var(--surface-alt)] p-4 text-sm font-bold shadow-[3px_3px_0px_var(--border)]"
        >
          <div class="flex items-center justify-between">
            <span>{t('profile.stat_received')}</span>
            <span id="stat-points-received" class="font-black text-[var(--positive)]">+0</span>
          </div>
          <div class="flex items-center justify-between">
            <span>{t('profile.stat_deducted')}</span>
            <span id="stat-points-deducted" class="font-black text-[var(--negative)]">-0</span>
          </div>
          <hr class="my-1 border-t-2 border-dashed border-[var(--border)]" />
          <div class="flex items-center justify-between">
            <span>{t('profile.stat_given')}</span>
            <span id="stat-points-given" class="font-black">0</span>
          </div>
          <div class="flex items-center justify-between">
            <span>{t('profile.stat_taken')}</span>
            <span id="stat-points-taken" class="font-black">0</span>
          </div>
          <hr class="my-1 border-t-2 border-dashed border-[var(--border)]" />
          <div class="flex items-center justify-between text-xs text-[var(--muted)] italic">
            <span>{t('profile.stat_interactions')}</span>
            <span id="stat-total-interactions" class="font-black text-[var(--text)] not-italic"
              >0</span
            >
          </div>
        </div>
      </div>

      <!-- Recent History Section -->
      <div>
        <label class="mb-2 block text-xs font-black tracking-wider text-[var(--muted)] uppercase"
          >{t('activity.title')}</label
        >
        <div
          id="detail-history-list"
          class="flex max-h-60 flex-col gap-2 overflow-y-auto pr-1 sm:max-h-48"
        >
          <!-- Populated by script -->
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { storage } from '../lib/storage';
  import { updateMember } from '../lib/api';
  import { getClientLocale, useTranslation } from '../lib/i18n';

  const locale = getClientLocale();
  const t = useTranslation(locale);

  const modal = document.getElementById('colega-detail-modal') as HTMLElement;
  if (modal) {
    const members = JSON.parse(modal.dataset.members!) as any[];
    const events = JSON.parse(modal.dataset.events!) as any[];

    const closeModal = () => {
      modal.classList.remove('open');
      document.body.style.overflow = '';
    };

    modal.querySelector('#close-detail-modal-btn')?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    let selectedEmoji = '';
    const emojiPicker = modal.querySelector('#edit-emoji-picker')!;
    const emojiBtns = emojiPicker.querySelectorAll('.edit-emoji-btn');
    emojiBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        emojiBtns.forEach((b) => {
          (b as HTMLElement).classList.remove(
            'bg-[var(--accent)]',
            'translate-x-0.5',
            '-translate-y-0.5',
            'shadow-none'
          );
          (b as HTMLElement).style.boxShadow = '2px 2px 0px var(--border)';
        });
        btn.classList.add('bg-[var(--accent)]', 'translate-x-0.5', '-translate-y-0.5');
        (btn as HTMLElement).style.boxShadow = 'none';
        selectedEmoji = (btn as HTMLElement).dataset.emoji!;
      });
    });

    const openModalForMember = (memberId: string) => {
      const member = members.find((m) => m.id === memberId);
      if (!member) return;

      // Reset edit view
      const infoHeader = modal.querySelector('#detail-info-header') as HTMLElement;
      const editForm = modal.querySelector('#edit-profile-form') as HTMLElement;
      const errorEl = modal.querySelector('#edit-error') as HTMLElement;

      infoHeader.style.display = 'flex';
      editForm.style.display = 'none';
      errorEl.classList.add('hidden');

      // Update avatar & name & joined date
      const avatarEl = modal.querySelector('#detail-avatar')!;
      avatarEl.textContent = member.avatarEmoji;

      const nameEl = modal.querySelector('#detail-name')!;
      nameEl.textContent = member.name;

      const joinedEl = modal.querySelector('#detail-joined')!;
      const joinedDate = new Date(member.joinedAt);
      joinedEl.textContent = t('profile.joined', { date: joinedDate.toLocaleDateString(locale) });

      // Show edit button if it's the current user
      const groupId =
        (document.getElementById('group-page-container') as HTMLElement)?.dataset.groupId || '';
      const saved = storage.getMember(groupId);
      const editBtn = modal.querySelector('#edit-profile-btn') as HTMLElement;

      if (saved && saved.id === memberId) {
        editBtn.style.display = 'inline-flex';
      } else {
        editBtn.style.display = 'none';
      }

      // Bind edit handlers
      editBtn.onclick = () => {
        infoHeader.style.display = 'none';
        editForm.style.display = 'flex';

        const nameInput = modal.querySelector('#edit-name') as HTMLInputElement;
        nameInput.value = member.name;

        selectedEmoji = member.avatarEmoji;
        emojiBtns.forEach((b) => {
          const btnEmoji = (b as HTMLElement).dataset.emoji!;
          if (btnEmoji === selectedEmoji) {
            (b as HTMLElement).classList.add(
              'bg-[var(--accent)]',
              'translate-x-0.5',
              '-translate-y-0.5'
            );
            (b as HTMLElement).style.boxShadow = 'none';
          } else {
            (b as HTMLElement).classList.remove(
              'bg-[var(--accent)]',
              'translate-x-0.5',
              '-translate-y-0.5',
              'shadow-none'
            );
            (b as HTMLElement).style.boxShadow = '2px 2px 0px var(--border)';
          }
        });
      };

      const cancelBtn = modal.querySelector('#cancel-profile-btn') as HTMLElement;
      cancelBtn.onclick = () => {
        infoHeader.style.display = 'flex';
        editForm.style.display = 'none';
        errorEl.classList.add('hidden');
      };

      const saveBtn = modal.querySelector('#save-profile-btn') as HTMLButtonElement;
      saveBtn.onclick = async () => {
        const nameInput = modal.querySelector('#edit-name') as HTMLInputElement;
        const name = nameInput.value.trim();

        if (!name) {
          errorEl.textContent = t('profile.name_required');
          errorEl.classList.remove('hidden');
          return;
        }

        saveBtn.disabled = true;
        saveBtn.textContent = t('profile.saving');
        errorEl.classList.add('hidden');

        try {
          await updateMember(memberId, {
            requestingMemberId: saved.id,
            name,
            emoji: selectedEmoji,
          });

          // Update client storage
          saved.name = name;
          saved.avatarEmoji = selectedEmoji;
          storage.saveMember(groupId, saved);

          // Update group list in storage
          const pageContainer = document.getElementById('group-page-container')!;
          storage.saveGroupToList(
            groupId,
            pageContainer.dataset.groupName || '',
            pageContainer.dataset.groupDescription || '',
            { id: memberId, name, avatarEmoji: selectedEmoji }
          );

          window.location.reload();
        } catch (err: any) {
          errorEl.textContent = err.message;
          errorEl.classList.remove('hidden');
          saveBtn.disabled = false;
          saveBtn.textContent = t('profile.save');
        }
      };

      // Calculate exact points
      const exactPoints = events
        .filter((e) => e.toMemberId === memberId)
        .reduce((sum, e) => sum + e.delta, 0);

      const pointsEl = modal.querySelector('#detail-points')!;
      pointsEl.textContent = exactPoints > 0 ? `+${exactPoints}` : `${exactPoints}`;
      pointsEl.className = `mt-2 text-3xl font-black tabular-nums ${
        exactPoints > 0
          ? 'text-[var(--positive)]'
          : exactPoints < 0
            ? 'text-[var(--negative)]'
            : 'text-[var(--muted)]'
      }`;

      // Calculate Rank
      const totals: Record<string, number> = {};
      members.forEach((m) => {
        totals[m.id] = 0;
      });
      events.forEach((e) => {
        if (e.toMemberId in totals) {
          totals[e.toMemberId] += e.delta;
        }
      });
      const sortedMembers = [...members].sort((a, b) => (totals[b.id] ?? 0) - (totals[a.id] ?? 0));
      const rankIndex = sortedMembers.findIndex((m) => m.id === memberId);
      const rank = rankIndex + 1;

      const rankEl = modal.querySelector('#detail-rank')!;
      const medalEmojis = ['🥇', '🥈', '🥉'];
      const medal = medalEmojis[rankIndex] ? `${medalEmojis[rankIndex]} ` : '';
      rankEl.innerHTML = `${medal}#${rank}`;

      // Statistics calculations
      const pointsReceived = events
        .filter((e) => e.toMemberId === memberId && e.delta > 0)
        .reduce((sum, e) => sum + e.delta, 0);

      const pointsDeducted = events
        .filter((e) => e.toMemberId === memberId && e.delta < 0)
        .reduce((sum, e) => sum + e.delta, 0);

      const pointsGiven = events
        .filter((e) => e.fromMemberId === memberId && e.toMemberId !== memberId && e.delta > 0)
        .reduce((sum, e) => sum + e.delta, 0);

      const pointsTaken = events
        .filter((e) => e.fromMemberId === memberId && e.toMemberId !== memberId && e.delta < 0)
        .reduce((sum, e) => sum + Math.abs(e.delta), 0);

      const totalInteractions = events.filter(
        (e) => e.toMemberId === memberId || e.fromMemberId === memberId
      ).length;

      modal.querySelector('#stat-points-received')!.textContent = `+${pointsReceived}`;
      modal.querySelector('#stat-points-deducted')!.textContent = `${pointsDeducted}`;
      modal.querySelector('#stat-points-given')!.textContent = `+${pointsGiven}`;
      modal.querySelector('#stat-points-taken')!.textContent = `-${pointsTaken}`;
      modal.querySelector('#stat-total-interactions')!.textContent = `${totalInteractions}`;

      // Populate history list
      const historyList = modal.querySelector('#detail-history-list')!;
      historyList.innerHTML = '';

      const memberEvents = events
        .filter((e) => e.toMemberId === memberId || e.fromMemberId === memberId)
        .slice(0, 5);

      if (memberEvents.length === 0) {
        historyList.innerHTML = `
          <div class="text-center py-6 text-sm font-bold text-[var(--muted)] italic">
            ${t('profile.no_activity')}
          </div>
        `;
      } else {
        memberEvents.forEach((e) => {
          const giver = members.find((m) => m.id === e.fromMemberId);
          const receiver = members.find((m) => m.id === e.toMemberId);
          const giverName = giver ? giver.name : 'Unknown';
          const receiverName = receiver ? receiver.name : 'Unknown';

          const card = document.createElement('div');
          card.className =
            'card card-sm p-3 bg-white text-xs flex justify-between items-center gap-2 border-2 border-[var(--border)] shadow-[2px_2px_0px_var(--border)]';

          let detailsHtml: string;
          let tagHtml: string;

          if (e.toMemberId === memberId) {
            // Received points
            detailsHtml = `
              <div class="min-w-0 flex-1">
                <span class="font-black">${t('profile.history_received', { name: giverName })}</span>
                ${e.reason ? `<p class="italic text-[var(--muted)] mt-0.5 truncate">"${e.reason}"</p>` : ''}
              </div>
            `;
            const isPos = e.delta > 0;
            tagHtml = `<span class="tag ${isPos ? 'tag-pos border-[var(--positive)]' : 'tag-neg border-[var(--negative)]'} font-black shrink-0 select-none">${e.delta > 0 ? `+${e.delta}` : e.delta}</span>`;
          } else {
            // Sent/gave/took points
            detailsHtml = `
              <div class="min-w-0 flex-1">
                <span class="font-black">${t('profile.history_sent', { name: receiverName })}</span>
                ${e.reason ? `<p class="italic text-[var(--muted)] mt-0.5 truncate">"${e.reason}"</p>` : ''}
              </div>
            `;
            const isPos = e.delta > 0;
            const tagText = isPos
              ? t('profile.history_gave_tag', { delta: e.delta })
              : t('profile.history_took_tag', { delta: e.delta });
            tagHtml = `<span class="tag ${isPos ? 'tag-accent border-[var(--border)]' : 'tag-neg border-[var(--negative)]'} font-black shrink-0 select-none">${tagText}</span>`;
          }

          card.innerHTML = detailsHtml + tagHtml;
          historyList.appendChild(card);
        });
      }

      // Show modal
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    };

    // Bind global click listener on data-action="view-detail" rows
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const memberItem = target.closest('[data-action="view-detail"]');
      if (memberItem) {
        const memberId = memberItem.getAttribute('data-member-id');
        if (memberId) {
          openModalForMember(memberId);
        }
      }
    });
  }
</script>
