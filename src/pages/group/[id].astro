---
import Base from '../../layouts/Base.astro';
import { db } from '../../db';
import { groups, members, pointEvents } from '../../db/schema';
import { eq } from 'drizzle-orm';
import { calculatePointTotals } from '../../lib/points';
import Leaderboard from '../../components/Leaderboard.astro';
import RecentActivity from '../../components/RecentActivity.astro';
import JoinPrompt from '../../components/JoinPrompt.astro';
import PointsModal from '../../components/PointsModal.astro';
import ColegaDetailModal from '../../components/ColegaDetailModal.astro';

const { id } = Astro.params;
if (!id) return Astro.redirect('/');

const group = await db.query.groups.findFirst({ where: eq(groups.id, id) });
if (!group) return Astro.redirect('/');

const groupMembers = await db.query.members.findMany({
  where: eq(members.groupId, id),
  orderBy: (m, { asc }) => [asc(m.joinedAt)],
});

const allEvents = await db.query.pointEvents.findMany({
  where: eq(pointEvents.groupId, id),
  orderBy: (e, { desc }) => [desc(e.createdAt)],
});

const pointTotals = calculatePointTotals(groupMembers, allEvents);
const recentEvents = allEvents.slice(0, 5);
const memberMap = Object.fromEntries(groupMembers.map((m) => [m.id, m]));
---

<Base title={group.name} description={`Manage friend points for ${group.name}`}>
  <div
    id="group-page-container"
    class="mx-auto max-w-2xl px-4 py-10"
    data-group-id={id}
    data-group-name={group.name}
    data-group-description={group.description ?? ''}
    data-group-members={JSON.stringify(groupMembers)}
    data-vapid-public-key={import.meta.env.VAPID_PUBLIC_KEY ?? ''}
  >
    <!-- Header -->
    <header class="animate-slide-up mb-10">
      <div class="mb-6 flex items-center justify-between gap-4">
        <a
          href="/"
          class="inline-flex shrink-0 items-center gap-1 border-2 border-[var(--border)] bg-[var(--accent)] px-2 py-0.5 text-sm font-black tracking-widest uppercase transition-colors hover:text-[var(--brand)]"
        >
          ← Home
        </a>
        <div class="flex shrink-0 flex-wrap justify-end gap-1.5 sm:gap-3">
          <button
            id="copy-invite-btn"
            class="btn btn-ghost px-2 py-1.5 text-[10px] uppercase italic sm:px-4 sm:py-2 sm:text-sm"
          >
            🔗 Invite
          </button>
          <a
            href={`/group/${id}/history`}
            class="btn btn-ghost px-2 py-1.5 text-[10px] uppercase italic sm:px-4 sm:py-2 sm:text-sm"
          >
            📜 History
          </a>
          <button
            id="leave-group-btn"
            class="btn btn-outline hidden border-[var(--negative)] px-2 py-1.5 text-[10px] text-[var(--negative)] uppercase italic hover:bg-[var(--negative-bg)] sm:px-4 sm:py-2 sm:text-sm"
          >
            🚪 Leave
          </button>
        </div>
      </div>
      <h1 class="mt-2 text-5xl leading-none font-black tracking-tighter uppercase">
        {group.name}
      </h1>
      {
        group.description && (
          <p class="mt-2 text-lg font-bold text-[var(--muted)] italic">{group.description}</p>
        )
      }
    </header>

    <JoinPrompt groupId={id} groupName={group.name} groupDescription={group.description ?? ''} />

    <Leaderboard members={groupMembers} pointTotals={pointTotals} />

    <!-- Add Points CTA (only shown if member) -->
    <div id="add-points-section" class="animate-slide-up mb-12 hidden">
      <button
        id="add-points-btn"
        class="btn btn-primary w-full py-6 text-3xl uppercase italic shadow-lg"
        disabled={groupMembers.length === 1}
        title={groupMembers.length === 1 ? 'Add more members to give or take points' : undefined}
      >
        ⭐ Give / Take Points
      </button>
    </div>

    <RecentActivity
      events={recentEvents}
      memberMap={memberMap}
      groupId={id}
      totalEventsCount={allEvents.length}
    />

    <PointsModal groupId={id} members={groupMembers} />

    <ColegaDetailModal members={groupMembers} events={allEvents} />

    <!-- Sync to App (shown if member and in browser) -->
    <div
      id="sync-section"
      class="card animate-fade-in mt-8 hidden border-dashed border-[var(--brand)] bg-[var(--accent-light)] p-5"
    >
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-lg leading-none font-black uppercase">📱 Sync to App</p>
          <p class="mt-1 text-sm font-bold text-[var(--muted)] italic">
            Move this group to your installed app
          </p>
        </div>
        <button
          id="sync-gen-btn"
          class="btn btn-primary px-6 py-2 text-sm uppercase italic shadow-sm"
        >
          Get Sync Code
        </button>
      </div>

      <!-- Code display (initially hidden) -->
      <div
        id="sync-code-container"
        class="mt-4 hidden border-2 border-[var(--border)] bg-white p-4 text-center shadow-[4px_4px_0px_var(--border)]"
      >
        <p class="mb-2 text-xs font-black tracking-widest uppercase">Your Sync Code</p>
        <div
          id="sync-code-text"
          class="text-4xl font-black tracking-widest text-[var(--brand)] uppercase"
        >
          ------
        </div>
        <p class="mt-3 text-[10px] font-bold text-[var(--muted)] italic">
          Enter this on the Home screen of your ColegaPoints app. Expires in 10 min.
        </p>
        <button id="sync-copy-btn" class="btn btn-ghost mt-4 w-full py-2 text-xs uppercase">
          📋 Copy Code
        </button>
      </div>
    </div>

    <!-- Push toggle (shown if member) -->
    <div
      id="push-toggle-section"
      class="card animate-fade-in mt-8 flex hidden items-center justify-between bg-[var(--surface-alt)] p-5"
    >
      <div>
        <p class="text-lg leading-none font-black uppercase">Push Notifications</p>
        <p class="mt-1 text-sm font-bold text-[var(--muted)] italic">Get notified on updates</p>
      </div>
      <button
        id="push-toggle-btn"
        class="relative h-8 w-14 border-4 border-[var(--border)] bg-white shadow-[2px_2px_0px_var(--border)] transition-colors duration-200 focus:outline-none"
        role="switch"
        aria-checked="false"
      >
        <span
          class="push-thumb absolute top-0.5 left-0.5 h-5 w-5 border-2 border-[var(--border)] bg-[var(--border)] shadow-sm transition-transform duration-200"
        ></span>
      </button>
    </div>

    <!-- Leave Group Confirmation Modal -->
    <div
      id="leave-modal"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-[rgba(0,0,0,0.8)] p-4"
    >
      <div class="card animate-pop-in w-full max-w-sm p-8">
        <div class="mb-6 text-center text-5xl">🚪</div>
        <h3 class="mb-3 text-center text-3xl font-black uppercase italic">Leave group?</h3>
        <p class="mb-8 text-center text-base leading-tight font-bold italic">
          You'll be removed from <span
            id="leave-group-name"
            class="bg-[var(--accent)] px-1 underline"></span>. Your history stays, but the squad
          will miss you.
        </p>
        <div class="flex gap-4">
          <button id="leave-cancel-btn" class="btn btn-ghost flex-1 py-4 font-black uppercase">
            Cancel
          </button>
          <button
            id="leave-confirm-btn"
            class="btn btn-danger flex-1 py-4 font-black uppercase italic shadow-lg"
          >
            Leave
          </button>
        </div>
        <p
          id="leave-error"
          class="mt-4 hidden border-2 border-[var(--negative)] bg-[var(--negative-bg)] p-2 text-center text-sm font-bold text-[var(--negative)]"
        >
        </p>
      </div>
    </div>
  </div>
</Base>

<script>
  import { storage } from '../../lib/storage';
  import { leaveGroup, subscribePush, createSyncCode } from '../../lib/api';

  const container = document.getElementById('group-page-container') as HTMLElement;
  const groupId = container.dataset.groupId!;
  const groupName = container.dataset.groupName!;
  const vapidPublicKey = container.dataset.vapidPublicKey!;

  // ── Init ────────────────────────────────────────────────────────────────────
  const saved = storage.getMember(groupId);

  if (!saved) {
    document.getElementById('join-prompt')?.classList.remove('hidden');
  } else {
    document.getElementById('add-points-section')?.classList.remove('hidden');
    document.getElementById('push-toggle-section')?.classList.remove('hidden');
    document.getElementById('leave-group-btn')?.classList.remove('hidden');

    // Only show sync if NOT in standalone mode
    if (!window.matchMedia('(display-mode: standalone)').matches) {
      document.getElementById('sync-section')?.classList.remove('hidden');
      initSyncFlow();
    }

    initPushToggle(saved);
  }

  // ── Sync Flow ──────────────────────────────────────────────────────────────
  function initSyncFlow() {
    const genBtn = document.getElementById('sync-gen-btn') as HTMLButtonElement;
    const codeContainer = document.getElementById('sync-code-container');
    const codeText = document.getElementById('sync-code-text');
    const copyBtn = document.getElementById('sync-copy-btn') as HTMLButtonElement;

    genBtn?.addEventListener('click', async () => {
      genBtn.disabled = true;
      genBtn.textContent = 'Generating…';
      try {
        const code = await createSyncCode(groupId, saved.id);
        if (codeText) codeText.textContent = code;
        codeContainer?.classList.remove('hidden');
        genBtn.classList.add('hidden');
      } catch (err) {
        alert('Failed to generate code. Try again.');
        genBtn.disabled = false;
        genBtn.textContent = 'Get Sync Code';
      }
    });

    copyBtn?.addEventListener('click', async () => {
      if (codeText?.textContent) {
        await navigator.clipboard.writeText(codeText.textContent);
        const originalText = copyBtn.textContent;
        copyBtn.textContent = '✅ Copied!';
        setTimeout(() => {
          copyBtn.textContent = originalText;
        }, 2000);
      }
    });
  }

  // ── Copy invite ─────────────────────────────────────────────────────────────
  document.getElementById('copy-invite-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('copy-invite-btn')!;
    await navigator.clipboard.writeText(window.location.href);
    btn.textContent = '✅ Copied!';
    setTimeout(() => {
      btn.textContent = '🔗 Invite';
    }, 2000);
  });

  // ── Points modal ─────────────────────────────────────────────────────────────
  const modal = document.getElementById('points-modal');
  const closeModal = () => {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  };
  const openModal = () => {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  };

  const addPointsBtn = document.getElementById('add-points-btn') as HTMLButtonElement | null;
  addPointsBtn?.addEventListener('click', () => {
    if (addPointsBtn.disabled) return;
    openModal();
  });
  document.getElementById('close-modal-btn')?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // ── Push notifications ───────────────────────────────────────────────────────
  function urlBase64ToUint8Array(base64String: string) {
    const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
    const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    const raw = atob(base64);
    return Uint8Array.from([...raw].map((c) => c.charCodeAt(0)));
  }

  async function initPushToggle(member: any) {
    if (!('serviceWorker' in navigator) || !('PushManager' in window) || !vapidPublicKey) return;
    const toggleBtn = document.getElementById('push-toggle-btn') as HTMLButtonElement;
    const thumb = toggleBtn?.querySelector('.push-thumb');

    // Check current state
    const reg = await navigator.serviceWorker.register('/sw.js');
    const existingSub = await reg.pushManager.getSubscription();

    const setActive = (active: boolean) => {
      toggleBtn?.setAttribute('aria-checked', active ? 'true' : 'false');
      if (active) {
        toggleBtn?.style.setProperty('background-color', 'var(--accent)');
        thumb?.classList.add('translate-x-6');
      } else {
        toggleBtn?.style.removeProperty('background-color');
        thumb?.classList.remove('translate-x-6');
      }
    };

    setActive(!!existingSub);

    toggleBtn?.addEventListener('click', async () => {
      const isOn = toggleBtn.getAttribute('aria-checked') === 'true';
      if (isOn) {
        const sub = await reg.pushManager.getSubscription();
        await sub?.unsubscribe();
        setActive(false);
      } else {
        try {
          const sub = await reg.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: urlBase64ToUint8Array(vapidPublicKey),
          });
          await subscribePush(groupId, member.id, sub.toJSON());
          setActive(true);
        } catch (e) {
          console.error('Push subscribe failed:', e);
        }
      }
    });
  }

  // ── Leave group ────────────────────────────────────────────────────────────────
  const leaveModal = document.getElementById('leave-modal');
  const leaveNameEl = document.getElementById('leave-group-name');
  const leaveErrorEl = document.getElementById('leave-error');
  const leaveConfirm = document.getElementById('leave-confirm-btn') as HTMLButtonElement;

  if (leaveNameEl) leaveNameEl.textContent = groupName;

  function openLeaveModal() {
    leaveModal?.classList.remove('hidden');
    leaveModal?.classList.add('flex');
  }
  function closeLeaveModal() {
    leaveModal?.classList.remove('flex');
    leaveModal?.classList.add('hidden');
    leaveErrorEl?.classList.add('hidden');
  }

  document.getElementById('leave-group-btn')?.addEventListener('click', openLeaveModal);
  document.getElementById('leave-cancel-btn')?.addEventListener('click', closeLeaveModal);
  leaveModal?.addEventListener('click', (e) => {
    if (e.target === leaveModal) closeLeaveModal();
  });

  leaveConfirm?.addEventListener('click', async () => {
    if (!saved) return;
    leaveConfirm.disabled = true;
    leaveConfirm.textContent = 'Leaving…';
    leaveErrorEl?.classList.add('hidden');

    try {
      await leaveGroup(groupId, saved.id);
      storage.removeMember(groupId);
      storage.removeGroupFromList(groupId);
      window.location.href = '/';
    } catch (err: any) {
      if (leaveErrorEl) {
        leaveErrorEl.textContent = err.message;
        leaveErrorEl.classList.remove('hidden');
      }
      leaveConfirm.disabled = false;
      leaveConfirm.textContent = 'Leave';
    }
  });
</script>
