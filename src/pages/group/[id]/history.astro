---
import Base from '../../../layouts/Base.astro';
import { db } from '../../../db';
import { groups, members, pointEvents } from '../../../db/schema';
import { eq } from 'drizzle-orm';
import PointEventCard from '../../../components/PointEventCard.astro';

const { id } = Astro.params;
if (!id) return Astro.redirect('/');

const group = await db.query.groups.findFirst({ where: eq(groups.id, id) });
if (!group) return Astro.redirect('/');

const groupMembers = await db.query.members.findMany({
  where: eq(members.groupId, id),
});
const memberMap = Object.fromEntries(groupMembers.map((m) => [m.id, m]));

const events = await db.query.pointEvents.findMany({
  where: eq(pointEvents.groupId, id),
  orderBy: (e, { desc }) => [desc(e.createdAt)],
});
---

<Base title={`${group.name} — History`} description={`Full point history for ${group.name}`}>
  <div class="mx-auto max-w-2xl px-4 py-10">
    <header class="animate-slide-up mb-10">
      <a
        href={`/group/${id}`}
        class="mb-3 inline-flex items-center gap-1 border-2 border-[var(--border)] bg-[var(--accent)] px-2 py-0.5 text-sm font-black tracking-widest uppercase transition-colors hover:text-[var(--brand)]"
      >
        ← Back to {group.name}
      </a>
      <h1 class="mt-2 text-5xl leading-none font-black tracking-tighter uppercase">
        Point History
      </h1>
      <p class="mt-2 text-lg font-bold text-[var(--muted)] italic">
        {events.length} event{events.length !== 1 ? 's' : ''} total
      </p>
    </header>

    {
      events.length === 0 ? (
        <div class="card p-12 text-center">
          <div class="mb-4 text-6xl">🤷</div>
          <p class="text-2xl font-black uppercase italic">No point events yet.</p>
          <p class="mt-2 text-lg font-bold">Go give your colegas some points!</p>
        </div>
      ) : (
        <ul class="stagger flex flex-col gap-4">
          {events.map((ev) => {
            const from = memberMap[ev.fromMemberId];
            const to = memberMap[ev.toMemberId];
            if (!from || !to) return null;
            return (
              <PointEventCard
                from={from}
                to={to}
                delta={ev.delta}
                reason={ev.reason}
                createdAt={ev.createdAt}
                variant="full"
              />
            );
          })}
        </ul>
      )
    }
  </div>
</Base>
