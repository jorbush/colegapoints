---
import Base from '../../../layouts/Base.astro';
import { db } from '../../../db';
import { groups, members, pointEvents } from '../../../db/schema';
import { eq } from 'drizzle-orm';

const { id } = Astro.params;
if (!id) return Astro.redirect('/');

const group = await db.query.groups.findFirst({ where: eq(groups.id, id) });
if (!group) return Astro.redirect('/');

const groupMembers = await db.query.members.findMany({
  where: eq(members.groupId, id),
});
const memberMap = Object.fromEntries(groupMembers.map((m) => [m.id, m]));

const events = await db.query.pointEvents.findMany({
  where: eq(pointEvents.groupId, id),
  orderBy: (e, { desc }) => [desc(e.createdAt)],
});
---

<Base title={`${group.name} — History`} description={`Full point history for ${group.name}`}>
  <div class="max-w-2xl mx-auto px-4 py-10">

    <header class="mb-10 animate-slide-up">
      <a href={`/group/${id}`} class="text-sm font-black uppercase tracking-widest hover:text-[var(--brand)] transition-colors inline-flex items-center gap-1 mb-3 bg-[var(--accent)] border-2 border-[var(--border)] px-2 py-0.5">
        ← Back to {group.name}
      </a>
      <h1 class="text-5xl font-black uppercase tracking-tighter leading-none mt-2">Point History</h1>
      <p class="text-lg font-bold italic mt-2 text-[var(--muted)]">{events.length} event{events.length !== 1 ? 's' : ''} total</p>
    </header>

    {events.length === 0 ? (
      <div class="card p-12 text-center">
        <div class="text-6xl mb-4">🤷</div>
        <p class="text-2xl font-black uppercase italic">No point events yet.</p>
        <p class="text-lg font-bold mt-2">Go give your colegas some points!</p>
      </div>
    ) : (
      <ul class="flex flex-col gap-4 stagger">
        {events.map((ev) => {
          const from = memberMap[ev.fromMemberId];
          const to = memberMap[ev.toMemberId];
          const positive = ev.delta > 0;
          const date = new Date(ev.createdAt);
          if (!from || !to) return null;
          return (
            <li class="card p-5 flex items-center gap-5 animate-slide-up">
              <!-- Delta badge -->
              <div
                class={`w-16 h-16 border-4 border-[var(--border)] flex items-center justify-center text-2xl font-black flex-shrink-0 shadow-[3px_3px_0px_var(--border)] ${
                  positive
                    ? 'bg-[var(--positive-bg)] text-[var(--positive)]'
                    : 'bg-[var(--negative-bg)] text-[var(--negative)]'
                }`}
              >
                {positive ? '+' : ''}{ev.delta}
              </div>
              <!-- Info -->
              <div class="flex-1 min-w-0">
                <div class="text-base font-bold leading-tight">
                  <span class="font-black uppercase tracking-tight text-lg">{from.name}</span>
                  <span class="italic text-[var(--muted)]"> {positive ? 'gave' : 'took'} </span>
                  <span class={`font-black ${positive ? 'text-[var(--positive)]' : 'text-[var(--negative)]'}`}>
                    {Math.abs(ev.delta)} pt{Math.abs(ev.delta) !== 1 ? 's' : ''}
                  </span>
                  <span class="italic text-[var(--muted)]"> {positive ? 'to' : 'from'} </span>
                  <span class="font-black uppercase tracking-tight text-lg">{to.name}</span>
                </div>
                {ev.reason && (
                  <div class="mt-2 text-sm text-[var(--muted)] italic font-bold">"{ev.reason}"</div>
                )}
                <div class="mt-1 text-xs font-black uppercase text-[var(--muted)]">
                  {date.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' })}
                  {' · '}{date.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' })}
                </div>
              </div>
              <!-- Avatars -->
              <div class="flex flex-col items-center gap-1 flex-shrink-0">
                 <div class="w-10 h-10 border-2 border-[var(--border)] bg-white flex items-center justify-center text-xl shadow-[2px_2px_0px_var(--border)]" title={from.name}>
                  {from.avatarEmoji}
                </div>
                <span class="text-sm font-black">{positive ? '↓' : '↑'}</span>
                 <div class="w-10 h-10 border-2 border-[var(--border)] bg-white flex items-center justify-center text-xl shadow-[2px_2px_0px_var(--border)]" title={to.name}>
                  {to.avatarEmoji}
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</Base>
