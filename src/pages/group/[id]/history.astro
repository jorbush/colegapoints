---
import Base from '../../../layouts/Base.astro';
import { db } from '../../../db';
import { groups, members, pointEvents } from '../../../db/schema';
import { eq } from 'drizzle-orm';
import PointEventCard from '../../../components/PointEventCard.astro';

const { id } = Astro.params;
if (!id) return Astro.redirect('/');

const group = await db.query.groups.findFirst({ where: eq(groups.id, id) });
if (!group) return Astro.redirect('/');

const groupMembers = await db.query.members.findMany({
  where: eq(members.groupId, id),
});
const memberMap = Object.fromEntries(groupMembers.map((m) => [m.id, m]));

const events = await db.query.pointEvents.findMany({
  where: eq(pointEvents.groupId, id),
  orderBy: (e, { desc }) => [desc(e.createdAt)],
});
---

<Base title={`${group.name} — History`} description={`Full point history for ${group.name}`}>
  <div class="max-w-2xl mx-auto px-4 py-10">

    <header class="mb-10 animate-slide-up">
      <a href={`/group/${id}`} class="text-sm font-black uppercase tracking-widest hover:text-[var(--brand)] transition-colors inline-flex items-center gap-1 mb-3 bg-[var(--accent)] border-2 border-[var(--border)] px-2 py-0.5">
        ← Back to {group.name}
      </a>
      <h1 class="text-5xl font-black uppercase tracking-tighter leading-none mt-2">Point History</h1>
      <p class="text-lg font-bold italic mt-2 text-[var(--muted)]">{events.length} event{events.length !== 1 ? 's' : ''} total</p>
    </header>

    {events.length === 0 ? (
      <div class="card p-12 text-center">
        <div class="text-6xl mb-4">🤷</div>
        <p class="text-2xl font-black uppercase italic">No point events yet.</p>
        <p class="text-lg font-bold mt-2">Go give your colegas some points!</p>
      </div>
    ) : (
      <ul class="flex flex-col gap-4 stagger">
        {events.map((ev) => {
          const from = memberMap[ev.fromMemberId];
          const to = memberMap[ev.toMemberId];
          if (!from || !to) return null;
          return (
            <PointEventCard 
              from={from} 
              to={to} 
              delta={ev.delta} 
              reason={ev.reason} 
              createdAt={ev.createdAt} 
              variant="full"
            />
          );
        })}
      </ul>
    )}
  </div>
</Base>
