---
import Base from "../layouts/Base.astro";
---

<Base title="Home">
  <main class="max-w-lg mx-auto px-4 py-16 flex flex-col gap-10">
    <!-- Logo / Hero -->
    <header class="text-center animate-slide-up">
      <img
        src="/favicon.svg"
        alt="ColegaPoints Logo"
        class="w-24 h-24 mx-auto mb-6 animate-pop-in"
        style="animation-delay:100ms"
      />
      <h1
        class="text-5xl sm:text-6xl font-black leading-tight mb-3 uppercase tracking-tighter"
      >
        Colega<span class="text-[var(--brand)]">Points</span>
      </h1>
      <p class="text-xl font-bold max-w-xs mx-auto leading-tight italic">
        The scoreboard your friend group actually deserves.
      </p>
    </header>

    <!-- Your Groups (populated by JS from localStorage) -->
    <section
      id="your-groups-section"
      class="hidden animate-slide-up"
      style="animation-delay:100ms"
    >
      <h2
        class="text-sm font-black uppercase tracking-widest mb-3 bg-[var(--accent)] inline-block px-2 border-2 border-[var(--border)]"
      >
        Your Groups
      </h2>
      <ul id="your-groups-list" class="flex flex-col gap-4 stagger">
        <!-- injected by JS -->
      </ul>
    </section>

    <!-- Divider (shown only when groups exist) -->
    <div id="divider" class="hidden flex items-center gap-3">
      <div class="flex-1 h-1 bg-[var(--border)]"></div>
      <span class="text-sm font-black uppercase tracking-widest"
        >or start fresh</span
      >
      <div class="flex-1 h-1 bg-[var(--border)]"></div>
    </div>

    <!-- Create group card -->
    <section
      class="card p-8 w-full animate-slide-up"
      style="animation-delay:150ms"
    >
      <h2
        class="text-2xl font-black mb-6 flex items-center gap-2 uppercase italic"
      >
        <span>🎉</span> Start a new group
      </h2>
      <form id="create-group-form" class="flex flex-col gap-5">
        <div class="flex flex-col gap-1">
          <label for="group-name" class="text-sm font-black uppercase"
            >Group name *</label
          >
          <input
            id="group-name"
            name="name"
            type="text"
            required
            placeholder="e.g. The Gang, Squad Goals…"
            maxlength="50"
            class="input"
          />
        </div>
        <div class="flex flex-col gap-1">
          <label for="group-desc" class="text-sm font-black uppercase"
            >Description (optional)</label
          >
          <input
            id="group-desc"
            name="description"
            type="text"
            placeholder="What's this crew about?"
            maxlength="120"
            class="input"
          />
        </div>
        <button
          id="create-btn"
          type="submit"
          class="btn btn-primary w-full py-4 text-xl uppercase italic mt-2"
        >
          Create Group →
        </button>
      </form>
      <p
        id="create-error"
        class="text-[var(--negative)] font-bold text-sm mt-3 hidden p-2 border-2 border-[var(--negative)] bg-[var(--negative-bg)]"
      >
      </p>
    </section>

    <!-- Invite hint -->
    <p
      class="text-center text-sm font-bold animate-fade-in"
      style="animation-delay:300ms"
    >
      Got an invite link? Just open it — you'll join automatically. 🔗
    </p>
  </main>
</Base>

<script>
  // ── Your Groups ────────────────────────────────────────────────────────────
  function loadGroups() {
    try {
      return JSON.parse(localStorage.getItem("cp_groups") ?? "[]");
    } catch {
      return [];
    }
  }

  function renderGroups() {
    const groups = loadGroups();
    if (!groups.length) return;

    const section = document.getElementById("your-groups-section")!;
    const list = document.getElementById("your-groups-list")!;
    const divider = document.getElementById("divider")!;

    section.classList.remove("hidden");
    divider.classList.remove("hidden");
    divider.classList.add("flex");

    list.innerHTML = "";
    groups.forEach((g: any, i: number) => {
      const li = document.createElement("li");
      li.className = "animate-slide-up";
      li.style.animationDelay = `${i * 60}ms`;
      li.innerHTML = `
        <a href="/group/${g.groupId}"
          class="card card-sm flex items-center gap-4 p-4 hover:translate-x-1 hover:-translate-y-1 transition-transform group block"
          aria-label="Go to ${g.groupName}">
          <!-- Emoji avatar -->
          <div class="w-16 h-16 border-2 border-[var(--border)] flex items-center justify-center text-4xl flex-shrink-0 bg-[var(--accent-light)] shadow-[2px_2px_0px_var(--border)]">
            ${g.memberEmoji}
          </div>
          <!-- Info -->
          <div class="flex-1 min-w-0">
            <div class="font-black text-xl truncate uppercase tracking-tight group-hover:text-[var(--brand)] transition-colors">
              ${g.groupName}
            </div>
            ${g.groupDescription ? `<div class="text-sm font-bold text-[var(--muted)] truncate mt-0.5 italic">${g.groupDescription}</div>` : ""}
            <div class="mt-2">
              <span class="tag tag-accent">You: ${g.memberName}</span>
            </div>
          </div>
          <!-- Arrow -->
          <div class="font-black text-2xl group-hover:translate-x-1 transition-transform flex-shrink-0">
            →
          </div>
        </a>
      `;
      list.appendChild(li);
    });
  }

  renderGroups();

  // ── Create Group ──────────────────────────────────────────────────────────
  const form = document.getElementById("create-group-form") as HTMLFormElement;
  const btn = document.getElementById("create-btn") as HTMLButtonElement;
  const errorEl = document.getElementById(
    "create-error",
  ) as HTMLParagraphElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = "Creating…";
    errorEl.classList.add("hidden");

    const data = new FormData(form);
    try {
      const res = await fetch("/api/groups", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: data.get("name"),
          description: data.get("description") || null,
        }),
      });
      const json = await res.json();
      if (res.ok) {
        window.location.href = `/group/${json.id}`;
      } else {
        throw new Error(json.error ?? "Unknown error");
      }
    } catch (err: any) {
      errorEl.textContent = err.message;
      errorEl.classList.remove("hidden");
      btn.disabled = false;
      btn.textContent = "Create Group →";
    }
  });
</script>
