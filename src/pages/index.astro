---
import Base from '../layouts/Base.astro';
import { getLocale, useTranslation } from '../lib/i18n';

const locale = getLocale(Astro.cookies, Astro.request.headers);
const t = useTranslation(locale);
---

<Base title={t('home.title')}>
  <main class="mx-auto flex max-w-lg flex-col gap-10 px-4 py-16">
    <!-- Logo / Hero -->
    <header class="animate-slide-up text-center">
      <img
        src="/favicon.svg"
        alt="ColegaPoints Logo"
        class="animate-pop-in mx-auto mb-6 h-24 w-24"
        style="animation-delay:100ms"
      />
      <h1 class="mb-3 text-5xl leading-tight font-black tracking-tighter uppercase sm:text-6xl">
        Colega<span class="text-[var(--brand)]">Points</span>
      </h1>
      <p class="mx-auto max-w-xs text-xl leading-tight font-bold italic">
        {t('home.hero_subtitle')}
      </p>
    </header>

    <!-- Your Groups (populated by JS from localStorage) -->
    <section id="your-groups-section" class="animate-slide-up hidden" style="animation-delay:100ms">
      <h2
        class="mb-3 inline-block border-2 border-[var(--border)] bg-[var(--accent)] px-2 text-sm font-black tracking-widest uppercase"
      >
        {t('home.your_groups')}
      </h2>
      <ul id="your-groups-list" class="stagger flex flex-col gap-4">
        <!-- injected by JS -->
      </ul>
    </section>

    <!-- Divider (shown only when groups exist) -->
    <div id="divider" class="flex hidden items-center gap-3">
      <div class="h-1 flex-1 bg-[var(--border)]"></div>
      <span class="text-sm font-black tracking-widest uppercase">{t('home.or_start_fresh')}</span>
      <div class="h-1 flex-1 bg-[var(--border)]"></div>
    </div>

    <!-- Create group card -->
    <section class="card animate-slide-up w-full p-8" style="animation-delay:150ms">
      <h2 class="mb-6 flex items-center gap-2 text-2xl font-black uppercase italic">
        <span>🎉</span>
        {t('home.start_new_group')}
      </h2>
      <form id="create-group-form" class="flex flex-col gap-5">
        <div class="flex flex-col gap-1">
          <label for="group-name" class="text-sm font-black uppercase">{t('home.group_name')}</label
          >
          <input
            id="group-name"
            name="name"
            type="text"
            required
            placeholder={t('home.group_name_placeholder')}
            maxlength="50"
            class="input"
          />
        </div>
        <div class="flex flex-col gap-1">
          <label for="group-desc" class="text-sm font-black uppercase"
            >{t('home.group_description')}</label
          >
          <input
            id="group-desc"
            name="description"
            type="text"
            placeholder={t('home.group_description_placeholder')}
            maxlength="120"
            class="input"
          />
        </div>
        <button
          id="create-btn"
          type="submit"
          class="btn btn-primary mt-2 w-full py-4 text-xl uppercase italic"
        >
          {t('home.create_group')}
        </button>
      </form>
      <p
        id="create-error"
        class="mt-3 hidden border-2 border-[var(--negative)] bg-[var(--negative-bg)] p-2 text-sm font-bold text-[var(--negative)]"
      >
      </p>
    </section>

    <!-- Sync / Import section -->
    <section class="card animate-slide-up w-full p-8" style="animation-delay:150ms">
      <h2 class="mb-4 flex items-center gap-2 text-2xl font-black uppercase italic">
        <span>🔄</span>
        {t('home.sync_existing_group')}
      </h2>
      <p class="mb-6 text-sm font-bold text-[var(--muted)] italic">
        {t('home.sync_hint')}
      </p>
      <div class="flex gap-2">
        <input
          id="sync-code-input"
          type="text"
          placeholder={t('home.sync_placeholder')}
          maxlength="6"
          class="input flex-1 tracking-widest uppercase"
        />
        <button id="sync-redeem-btn" class="btn btn-primary px-6 py-4 uppercase italic">
          {t('home.sync_button')}
        </button>
      </div>
      <p
        id="sync-error"
        class="mt-3 hidden border-2 border-[var(--negative)] bg-[var(--negative-bg)] p-2 text-sm font-bold text-[var(--negative)]"
      >
      </p>
    </section>

    <!-- Invite hint -->
    <p class="animate-fade-in text-center text-sm font-bold" style="animation-delay:300ms">
      {t('home.invite_hint')}
    </p>
  </main>
</Base>

<script>
  import { storage } from '../lib/storage';
  import { createGroup, redeemSyncCode } from '../lib/api';
  import { getClientLocale, useTranslation } from '../lib/i18n';

  const locale = getClientLocale();
  const t = useTranslation(locale);

  function renderGroups() {
    const groups = storage.getGroups();
    if (!groups.length) return;

    const section = document.getElementById('your-groups-section')!;
    const list = document.getElementById('your-groups-list')!;
    const divider = document.getElementById('divider')!;

    section.classList.remove('hidden');
    divider.classList.remove('hidden');
    divider.classList.add('flex');

    list.innerHTML = '';
    groups.forEach((g, i) => {
      const li = document.createElement('li');
      li.className = 'animate-slide-up';
      li.style.animationDelay = `${i * 60}ms`;
      li.innerHTML = `
        <a href="/group/${g.groupId}"
          class="card card-sm flex items-center gap-4 p-4 hover:translate-x-1 hover:-translate-y-1 transition-transform group block"
          aria-label="Go to ${g.groupName}">
          <!-- Emoji avatar -->
          <div class="w-16 h-16 border-2 border-[var(--border)] flex items-center justify-center text-4xl flex-shrink-0 bg-[var(--accent-light)] shadow-[2px_2px_0px_var(--border)]">
            ${g.memberEmoji}
          </div>
          <!-- Info -->
          <div class="flex-1 min-w-0">
            <div class="font-black text-xl truncate uppercase tracking-tight group-hover:text-[var(--brand)] transition-colors">
              ${g.groupName}
            </div>
            ${g.groupDescription ? `<div class="text-sm font-bold text-[var(--muted)] truncate mt-0.5 italic">${g.groupDescription}</div>` : ''}
            <div class="mt-2">
              <span class="tag tag-accent">${t('home.you', { name: g.memberName })}</span>
            </div>
          </div>
          <!-- Arrow -->
          <div class="font-black text-2xl group-hover:translate-x-1 transition-transform flex-shrink-0">
            →
          </div>
        </a>
      `;
      list.appendChild(li);
    });
  }

  renderGroups();

  // ── Create Group ──────────────────────────────────────────────────────────
  const form = document.getElementById('create-group-form') as HTMLFormElement;
  const btn = document.getElementById('create-btn') as HTMLButtonElement;
  const errorEl = document.getElementById('create-error') as HTMLParagraphElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = t('home.creating');
    errorEl.classList.add('hidden');

    const data = new FormData(form);
    try {
      const name = data.get('name') as string;
      const description = (data.get('description') as string) || null;
      const json = await createGroup(name, description);
      window.location.href = `/group/${json.id}`;
    } catch (err: any) {
      errorEl.textContent = err.message;
      errorEl.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = t('home.create_group');
    }
  });

  // ── Sync Code ─────────────────────────────────────────────────────────────
  const syncInput = document.getElementById('sync-code-input') as HTMLInputElement;
  const syncBtn = document.getElementById('sync-redeem-btn') as HTMLButtonElement;
  const syncError = document.getElementById('sync-error') as HTMLParagraphElement;

  syncBtn?.addEventListener('click', async () => {
    const code = syncInput.value.trim().toUpperCase();
    if (!code) return;

    syncBtn.disabled = true;
    syncBtn.textContent = '...';
    syncError.classList.add('hidden');

    try {
      const { member, group } = await redeemSyncCode(code);
      storage.saveMember(group.id, member);
      storage.saveGroupToList(group.id, group.name, group.description || '', member);
      window.location.href = `/group/${group.id}`;
    } catch (err: any) {
      syncError.textContent = err.message;
      syncError.classList.remove('hidden');
      syncBtn.disabled = false;
      syncBtn.textContent = t('home.sync_button');
    }
  });
</script>
